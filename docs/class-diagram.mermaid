classDiagram
    class SocketService {
      +connect(url, handlers)
      +sendAudio(chunk)
      +sendStop()
      +disconnect()
    }
    class AudioRecorderService {
      +start(sampleRate, onChunk)
      +stop()
    }
    class AsrGateway {
      +handleUpgrade(request, socket, head)
      +handleConnection(socket, request)
      -handleMessage(connection, data, isBinary)
    }
    class SessionManager {
      -connections Map
      +create(socket, options)
      +remove(socket)
    }
    class AsrBackendService {
      +forward(connection, data, isBinary)
      +close(connection)
      -connect(connection)
    }
    class MockSession {
      +onAudio(chunk)
      +onControl(value)
    }

    SocketService --> AsrGateway : native WebSocket
    AudioRecorderService --> SocketService : PCM chunks
    AsrGateway --> SessionManager
    AsrGateway --> AsrBackendService
    AsrBackendService --> MockSession : managed WebSocket
